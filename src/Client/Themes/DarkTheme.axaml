<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <!-- SessionEditor surfaces, feedback colors and shared control states. -->
        <Color x:Key="BackgroundPrimaryColor">#050505</Color>
        <Color x:Key="BackgroundSecondaryColor">#111111</Color>
        <Color x:Key="BackgroundTertiaryColor">#0A0A0A</Color>
        <Color x:Key="BackgroundHoverColor">#1A1A1A</Color>
        <Color x:Key="BackgroundCardHoverColor">#161616</Color>
        <Color x:Key="BackgroundPressedColor">#000000</Color>
        <Color x:Key="BackgroundSelectedColor">#222222</Color>
        <Color x:Key="BorderPrimaryColor">#333333</Color>
        <Color x:Key="BorderSecondaryColor">#222222</Color>
        <Color x:Key="BorderHoverColor">#555555</Color>
        <Color x:Key="BorderCardHoverColor">#666666</Color>
        <Color x:Key="TextPrimaryColor">#E0E0E0</Color>
        <Color x:Key="TextSecondaryColor">#AAAAAA</Color>
        <Color x:Key="TextMutedColor">#888888</Color>
        <Color x:Key="TextDisabledColor">#666666</Color>
        <Color x:Key="TextOnAccentColor">#FFFFFF</Color>
        <Color x:Key="AccentPrimaryColor">#2563EB</Color>
        <Color x:Key="AccentHoverColor">#3B82F6</Color>
        <Color x:Key="AccentPressedColor">#1D4ED8</Color>
        <Color x:Key="AccentInfoColor">#00AAFF</Color>
        <Color x:Key="ErrorPrimaryColor">#FF6B6B</Color>
        <Color x:Key="ErrorBackgroundColor">#3A1919</Color>
        <Color x:Key="ErrorHoverColor">#2A0000</Color>
        <Color x:Key="ErrorPressedColor">#440000</Color>
        <Color x:Key="ErrorBorderColor">#A84848</Color>
        <Color x:Key="ErrorTextColor">#FFCCCC</Color>
        <Color x:Key="ErrorFeedbackTextColor">#FF9A9A</Color>
        <Color x:Key="DangerPrimaryColor">#FF5555</Color>
        <Color x:Key="DangerBorderColor">#552222</Color>
        <Color x:Key="ValidationErrorColor">#FF4444</Color>
        <Color x:Key="SuccessPrimaryColor">#10B981</Color>
        <Color x:Key="SuccessTextColor">#8FE0A6</Color>
        <Color x:Key="SuccessBackgroundColor">#183622</Color>
        <Color x:Key="SuccessBorderColor">#3D8B56</Color>
        <Color x:Key="WarningPrimaryColor">#E6C878</Color>
        <Color x:Key="WarningBackgroundColor">#1A1710</Color>
        <Color x:Key="WarningBorderColor">#665522</Color>
        <Color x:Key="OverlayColor">#D9000000</Color>
        <!-- Transparent is transparent white; interpolating it produces a bright hover flash. -->
        <Color x:Key="TransparentColor">#00000000</Color>

        <SolidColorBrush x:Key="BackgroundPrimaryBrush" Color="{StaticResource BackgroundPrimaryColor}" />
        <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource BackgroundSecondaryColor}" />
        <SolidColorBrush x:Key="BackgroundTertiaryBrush" Color="{StaticResource BackgroundTertiaryColor}" />
