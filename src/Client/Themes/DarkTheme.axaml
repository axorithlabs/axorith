        <SolidColorBrush x:Key="RadioButtonOuterEllipseStrokeDisabled" Color="{StaticResource BorderSecondaryColor}" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillDisabled" Color="{StaticResource BackgroundSelectedColor}" />
        <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokeDisabled" Color="{StaticResource BackgroundSelectedColor}" />
        <SolidColorBrush x:Key="RadioButtonCheckGlyphFillDisabled" Color="{StaticResource TextDisabledColor}" />
        <SolidColorBrush x:Key="RadioButtonCheckGlyphStrokeDisabled" Color="{StaticResource TransparentColor}" />
        <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
        <Thickness x:Key="ButtonPadding">16,6</Thickness>
        <BoxShadows x:Key="DialogShadow">0 25 80 0 #80000000</BoxShadows>
        <BoxShadows x:Key="PopupShadow">0 10 28 0 #80000000</BoxShadows>
        <BoxShadows x:Key="ToastShadow">0 10 30 0 #80000000</BoxShadows>
        <BoxShadows x:Key="ErrorShadow">0 8 32 0 #80000000</BoxShadows>
    </Styles.Resources>

    <FluentTheme>
        <FluentTheme.Palettes>
            <ColorPaletteResources x:Key="Dark" Accent="{StaticResource AccentPrimaryColor}" />
        </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource BackgroundPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="UserControl">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Border.Card, Border.ItemCard, Border.SelectorCard, Button.CardButton > Border, Button.ItemCard > Border">
        <Setter Property="Background" Value="{DynamicResource BackgroundSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.ItemCard">
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
                <BrushTransition Property="Foreground" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="PathIcon">
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ContentPresenter, Tree=Visual}}" />
    </Style>

    <Style Selector="Button.accent">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.secondary, Button.icon, Button.link, Button.move-btn, Button.delete-btn, Button.RemoveDelay, Button.SidebarButton">
        <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.SidebarButton">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style Selector="Button.SidebarButton.Active">
        <Setter Property="Background" Value="{DynamicResource BackgroundSelectedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Padding" Value="6" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
    </Style>

    <Style Selector="Button.link">
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style Selector="Button.move-btn, Button.delete-btn">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
    </Style>

    <Style Selector="Button.RemoveDelay">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="CornerRadius" Value="9" />
    </Style>

    <Style Selector="Button.ConnectorNode">
        <Setter Property="Background" Value="{DynamicResource BackgroundPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerPrimaryBrush}" />
    </Style>

    <Style Selector="Button.delete-btn, Button.RemoveDelay">
        <Setter Property="Foreground" Value="{DynamicResource DangerPrimaryBrush}" />
    </Style>

    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.delete-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.RemoveDelay:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ErrorHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ValidationErrorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.delete-btn:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.RemoveDelay:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ErrorPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ValidationErrorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

    <Style Selector="Button.inline-action.success">
        <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
    </Style>

    <Style Selector="Button.inline-action.failure">
        <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorFeedbackTextBrush}" />
    </Style>

    <Style Selector="Button.inline-action.success /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
    </Style>

    <Style Selector="Button.inline-action.failure /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ErrorFeedbackTextBrush}" />
    </Style>

    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BackgroundTertiaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>

    <Style Selector="Button.success">
        <Setter Property="Background" Value="{DynamicResource SuccessPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

    <Style Selector="Button.success:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SuccessPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

    <Style Selector="Button.CardButton, Button.ItemCard">
        <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style Selector="Button.CardButton /template/ ContentPresenter#PART_ContentPresenter, Button.ItemCard /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TransparentBrush}" />
    </Style>

    <Style Selector="Button.ItemCard > Border">
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="Button.CardButton > Border">
        <Setter Property="Background" Value="{DynamicResource BackgroundTertiaryBrush}" />
    </Style>

    <Style Selector="Button.CardButton:pointerover > Border, Button.ItemCard:pointerover > Border, Border.SelectorCard:pointerover, ListBox.preset-list ListBoxItem:pointerover Border.PresetCard">
        <Setter Property="Background" Value="{DynamicResource BackgroundCardHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderCardHoverBrush}" />
    </Style>

    <Style Selector="Button.CardButton:pressed > Border, Button.ItemCard:pressed > Border">
        <Setter Property="Background" Value="{DynamicResource BackgroundPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderCardHoverBrush}" />
    </Style>

    <Style Selector="Button.CardButton:pointerover > Border, Button.CardButton:pressed > Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
    </Style>

    <Style Selector="Border.warning">
        <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.error">
        <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ValidationErrorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Border.ItemCard.error">
        <Setter Property="Background" Value="{DynamicResource BackgroundSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorPrimaryBrush}" />
    </Style>

    <Style Selector="Button.ItemCard.error > Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorPrimaryBrush}" />
    </Style>

    <Style Selector="TextBox, NumericUpDown, ComboBox">
        <Setter Property="Background" Value="{DynamicResource BackgroundPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextOnAccentBrush}" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style Selector="TextBox.setting-input">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="TextBox.appPicker">
        <Setter Property="CornerRadius" Value="6,0,0,6" />
    </Style>

    <Style Selector="TextBox.delay-input">
        <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="TextBox.delay-input:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource BackgroundSelectedBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="TextBox.error /template/ Border#PART_BorderElement, NumericUpDown.error /template/ TextBox /template/ Border#PART_BorderElement, ComboBox.error /template/ Border#Background, ComboBox.error /template/ Border#HighlightBackground">
        <Setter Property="BorderBrush" Value="{DynamicResource ValidationErrorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton">
        <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MaxDropDownHeight" Value="300" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <VirtualizingStackPanel />
            </ItemsPanelTemplate>
        </Setter>
    </Style>

    <Style Selector="ComboBox /template/ Border#PopupBorder">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Margin" Value="0,1" />
    </Style>

    <Style Selector="ComboBox.history">
        <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxDropDownHeight" Value="200" />
    </Style>

    <Style Selector="ComboBox.history /template/ ContentControl#ContentPresenter">
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="ContentTemplate">
            <DataTemplate>
                <PathIcon Data="M13.5,8H12V13L16.28,15.54L17,14.33L13.5,12.25V8M13,3A9,9 0 0,0 4,12H1L4.89,15.89L4.96,16.03L9,12H6A7,7 0 0,1 13,5A7,7 0 0,1 20,12A7,7 0 0,1 13,19C11.07,19 9.32,18.21 8.06,16.94L6.64,18.36C8.27,20 10.5,21 13,21A9,9 0 0,0 22,12A9,9 0 0,0 13,3Z"
                          Width="16" Height="16" />
            </DataTemplate>
        </Setter>
    </Style>

    <Style Selector="ComboBox.history /template/ PathIcon#DropDownGlyph">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="CheckBox, RadioButton, ToggleSwitch">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource BackgroundSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource BackgroundSelectedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
    </Style>

    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource BorderPrimaryBrush}" />
    </Style>

    <Style Selector="ListBox.preset-list ListBoxItem, ListBox.workflow-list ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <Style Selector="ListBox.preset-list ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style Selector="ListBox.workflow-list ListBoxItem">
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ListBox.preset-list ListBoxItem:selected /template/ ContentPresenter, ListBox.preset-list ListBoxItem:pointerover /template/ ContentPresenter, ListBox.workflow-list ListBoxItem:selected /template/ ContentPresenter, ListBox.workflow-list ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TransparentBrush}" />
    </Style>
</Styles>
