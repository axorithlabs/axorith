<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Axorith.Client</AssemblyName>
        <RootNamespace>Axorith.Client</RootNamespace>
        
        <Description>UI client for Axorith.</Description>
        
        <OutputType>WinExe</OutputType>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        
        <!-- Performance optimizations -->
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
        
        <!-- Size optimizations for Release -->
        <PublishSingleFile Condition="'$(Configuration)' == 'Release'">false</PublishSingleFile>
        <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">true</PublishReadyToRun>
        <PublishReadyToRunShowWarnings Condition="'$(Configuration)' == 'Release'">false</PublishReadyToRunShowWarnings>
        
        <!-- Startup performance -->
        <TieredCompilation>true</TieredCompilation>
        <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
        
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Axorith.Integrations.Tests" />
        <ProjectReference Include="..\Sdk\Axorith.Sdk.csproj" />
        <ProjectReference Include="..\Core\Axorith.Core.csproj" />
        <ProjectReference Include="..\Contracts\Axorith.Contracts.csproj" />
        <ProjectReference Include="..\Shared\Utils\Axorith.Shared.Utils.csproj" />
        <ProjectReference Include="..\Shared\Platform\Axorith.Shared.Platform.csproj" />
        <ProjectReference Include="..\Telemetry\Axorith.Telemetry.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"  />
        <PackageReference Include="Avalonia.Desktop"  />
        <PackageReference Include="Avalonia.Themes.Fluent"  />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
        <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" />
        <PackageReference Include="ReactiveUI.Avalonia"  />
        <PackageReference Include="ReactiveUI.Fody"  PrivateAssets="all" />
        <PackageReference Include="System.Reactive"  />
        <PackageReference Include="Tmds.DBus.Protocol" />
        <PackageReference Include="System.Drawing.Common"  />
        <PackageReference Include="Grpc.Net.Client"  />
        <PackageReference Include="Polly"  />
        <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics"  />
        <PackageReference Include="Serilog"  />
        <PackageReference Include="Serilog.Extensions.Logging"  />
        <PackageReference Include="Serilog.Sinks.Console"  />
        <PackageReference Include="Serilog.Sinks.File"  />
        <PackageReference Include="Serilog.Settings.Configuration"  />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <None Update="app.manifest">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="Assets\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>        
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="appsettings.development.json">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="runtimeconfig.template.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
