<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Axorith.Client.ViewModels"
             x:Class="Axorith.Client.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <StreamGeometry x:Key="HomeIcon">M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z</StreamGeometry>
        <StreamGeometry x:Key="PresetsIcon">M3,4H21V6H3V4M3,11H21V13H3V11M3,18H21V20H3V18M1,4H2V6H1V4M1,11H2V13H1V11M1,18H2V20H1V18Z</StreamGeometry>
        <StreamGeometry x:Key="SettingsIcon">M12,3A9,9 0 1,0 12,21A9,9 0 0,0 12,3M12,8A4,4 0 1,1 12,16A4,4 0 0,1 12,8Z</StreamGeometry>
        <StreamGeometry x:Key="PrivacyIcon">M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1Z</StreamGeometry>
        <StreamGeometry x:Key="AboutIcon">M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z</StreamGeometry>
        <StreamGeometry x:Key="GitHubIcon">M12,2A10,10 0 0,0 2,12C2,16.42 4.87,20.17 8.84,21.5C9.34,21.58 9.5,21.27 9.5,21C9.5,20.77 9.5,20.14 9.5,19.31C6.73,19.91 6.14,17.97 6.14,17.97C5.68,16.81 5.03,16.5 5.03,16.5C4.12,15.88 5.1,15.9 5.1,15.9C6.1,15.97 6.63,16.93 6.63,16.93C7.5,18.45 8.97,18 9.54,17.76C9.63,17.11 9.89,16.67 10.17,16.42C7.95,16.17 5.62,15.31 5.62,11.5C5.62,10.39 6,9.5 6.65,8.79C6.55,8.54 6.2,7.5 6.75,6.15C6.75,6.15 7.59,5.88 9.5,7.17C10.29,6.95 11.15,6.84 12,6.84C12.85,6.84 13.71,6.95 14.5,7.17C16.41,5.88 17.25,6.15 17.25,6.15C17.8,7.5 17.45,8.54 17.35,8.79C18,9.5 18.38,10.39 18.38,11.5C18.38,15.32 16.04,16.16 13.81,16.41C14.17,16.72 14.5,17.33 14.5,18.26C14.5,19.6 14.5,20.68 14.5,21C14.5,21.27 14.66,21.59 15.17,21.5C19.14,20.16 22,16.42 22,12A10,10 0 0,0 12,2Z</StreamGeometry>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.NavItem, Button.SectionNav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.NavItem /template/ ContentPresenter, Button.SectionNav /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.NavItem:pointerover /template/ ContentPresenter, Button.SectionNav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#161616" />
            <Setter Property="BorderBrush" Value="#333333" />
        </Style>
        <Style Selector="Button.NavItem.Active /template/ ContentPresenter, Button.SectionNav.Active /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A1A1A" />
            <Setter Property="BorderBrush" Value="#333333" />
        </Style>
        <Style Selector="Button.NavItem.Active:pointerover /template/ ContentPresenter, Button.SectionNav.Active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#222222" />
            <Setter Property="BorderBrush" Value="#555555" />
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value="ON" />
            <Setter Property="OffContent" Value="OFF" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="220,*" Background="#050505">
        <Border Grid.Column="0" Background="#0A0A0A" BorderBrush="#333333" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="14,20,14,16">
                <TextBlock Grid.Row="0" Text="AXORITH" FontSize="17" FontWeight="Bold"
                           Foreground="#E0E0E0" Margin="10,8,10,22" />

                <StackPanel Grid.Row="1" Spacing="6">
                    <Button Classes="NavItem" Command="{Binding BackCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource HomeIcon}" Width="17" Height="17" />
                            <TextBlock Text="Home" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="NavItem" Command="{Binding OpenPresetsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="{StaticResource PresetsIcon}" Width="17" Height="17" />
                            <TextBlock Text="Presets" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="3" Classes="Card" Padding="11" Margin="0,0,0,14"
                        IsVisible="{Binding MainViewModel.IsSessionActive}">
                    <StackPanel Spacing="5">
                        <TextBlock Text="ACTIVE SESSION" FontSize="10" Foreground="#888888" />
                        <TextBlock Text="{Binding MainViewModel.ActiveWorkspaceName}" FontSize="14"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                            <TextBlock Text="{Binding MainViewModel.ActiveSessionRemaining}" FontSize="13"
                                       FontWeight="SemiBold" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                <PathIcon Data="{StaticResource PrivacyIcon}" Width="13" Height="13"
                                          Foreground="{Binding MainViewModel.ActiveProtectionBrush}" />
                                <TextBlock Text="{Binding MainViewModel.ActiveProtectionStatus}" FontSize="10"
                                           Foreground="{Binding MainViewModel.ActiveProtectionBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Classes="Card" Padding="11" Margin="0,0,0,14"
                        IsVisible="{Binding MainViewModel.IsSessionActive, Converter={x:Static BoolConverters.Not}}">
                    <StackPanel Spacing="7">
                        <TextBlock Text="SESSION" FontSize="10" Foreground="#888888" />
                        <TextBlock Text="No active session" FontSize="13" Foreground="#B0B0B0" />
                        <Button Content="Open presets" Command="{Binding OpenPresetsCommand}" Padding="7,5" />
                    </StackPanel>
                </Border>

                <Button Grid.Row="4" Classes="NavItem Active">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="{StaticResource SettingsIcon}" Width="17" Height="17" />
                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="36,28,36,24" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
                <StackPanel Spacing="2">
                    <TextBlock Text="Settings" FontSize="30" FontWeight="Bold" Foreground="#E0E0E0" />
                    <TextBlock Text="Axorith preferences" Foreground="#B0B0B0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Save changes" Command="{Binding SaveCommand}"
                        Classes="accent" VerticalAlignment="Center" IsEnabled="{Binding HasUnsavedChanges}" />
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="190,*" ColumnSpacing="28">
                <Border Grid.Column="0" Classes="Card" Padding="10" VerticalAlignment="Stretch">
                    <StackPanel Spacing="5">
                        <TextBlock Text="SECTIONS" FontSize="10" Foreground="#888888" Margin="8,8,8,4" />
                        <Button Classes="SectionNav" Classes.Active="{Binding IsGeneralSection}"
                                Command="{Binding SelectSectionCommand}" CommandParameter="General" Content="General" />
                        <Button Classes="SectionNav" Classes.Active="{Binding IsAppearanceSection}"
                                Command="{Binding SelectSectionCommand}" CommandParameter="Appearance" Content="Appearance" />
                        <Button Classes="SectionNav" Classes.Active="{Binding IsPrivacySection}"
                                Command="{Binding SelectSectionCommand}" CommandParameter="Privacy" Content="Privacy" />
                        <Button Classes="SectionNav" Classes.Active="{Binding IsAboutSection}"
                                Command="{Binding SelectSectionCommand}" CommandParameter="About" Content="About" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <StackPanel Spacing="0" IsVisible="{Binding IsGeneralSection}">
                            <StackPanel Spacing="4" Margin="0,4,0,12">
                                <TextBlock Text="General" FontSize="22" FontWeight="Bold" />
                                <TextBlock Text="Startup and window behavior" Foreground="#B0B0B0" />
                            </StackPanel>

                            <Border BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="0,17">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Start Axorith with Windows" FontSize="15" />
                                        <TextBlock Text="Launch Axorith automatically after sign in"
                                                   FontSize="12" Foreground="#888888" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoStartEnabled}"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.Name="Start Axorith with Windows" />
                                </Grid>
                            </Border>

                            <Border BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="0,17">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20"
                                      IsEnabled="{Binding AutoStartEnabled}">
                                    <Grid.Styles>
                                        <Style Selector="Grid:disabled">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </Style>
                                    </Grid.Styles>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Start minimized" FontSize="15" />
                                        <TextBlock Text="Open directly in the tray" FontSize="12"
                                                   Foreground="#888888" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoStartMinimized}"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.Name="Start minimized" />
                                </Grid>
                            </Border>

                            <Border BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="0,17">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Minimize to tray on close" FontSize="15" />
                                        <TextBlock Text="Closing the window keeps Axorith running"
                                                   FontSize="12" Foreground="#888888" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTrayOnClose}"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.Name="Minimize to tray on close" />
                                </Grid>
                            </Border>

                            <Border BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="0,17">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Updates" FontSize="15" />
                                        <TextBlock Text="{Binding AppVersion, StringFormat='Current version {0}'}"
                                                   FontSize="12" Foreground="#888888" />
                                        <TextBlock Text="{Binding MainViewModel.UpdateVersion, StringFormat='Available: {0}'}"
                                                   FontSize="12" Foreground="#B0B0B0"
                                                   IsVisible="{Binding MainViewModel.UpdateAvailable}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <Button Content="Check now" Command="{Binding MainViewModel.CheckForUpdatesCommand}"
                                                IsEnabled="{Binding CanCheckForUpdates}" />
                                        <Button Content="Install" Classes="accent"
                                                Command="{Binding MainViewModel.InstallUpdateCommand}"
                                                IsVisible="{Binding MainViewModel.UpdateAvailable}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="18" IsVisible="{Binding IsAppearanceSection}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Appearance" FontSize="22" FontWeight="Bold" />
                                <TextBlock Text="Axorith interface colors" Foreground="#B0B0B0" />
                            </StackPanel>
                            <Border BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="0,18">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Theme" FontSize="15" />
                                        <TextBlock Text="Axorith keeps the current dark appearance."
                                                   FontSize="12" Foreground="#888888" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Dark" Foreground="#B0B0B0"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <StackPanel Spacing="12">
                                <TextBlock Text="Color palette" FontSize="15" FontWeight="SemiBold" />
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                    <Border Classes="Card" Padding="12">
                                        <StackPanel Spacing="8">
                                            <Border Height="34" Background="{DynamicResource SystemRegionBrush}"
                                                    BorderBrush="#333333" BorderThickness="1" CornerRadius="4" />
                                            <TextBlock Text="Canvas" FontSize="12" Foreground="#B0B0B0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Classes="Card" Padding="12">
                                        <StackPanel Spacing="8">
                                            <Border Height="34" Background="{DynamicResource CardBackgroundBrush}"
                                                    BorderBrush="#333333" BorderThickness="1" CornerRadius="4" />
                                            <TextBlock Text="Panel" FontSize="12" Foreground="#B0B0B0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Classes="Card" Padding="12">
                                        <StackPanel Spacing="8">
                                            <Border Height="34" Background="{DynamicResource SystemAccentBrush}"
                                                    CornerRadius="4" />
                                            <TextBlock Text="Action accent" FontSize="12" Foreground="#B0B0B0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="18" IsVisible="{Binding IsPrivacySection}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Privacy" FontSize="22" FontWeight="Bold" />
                                <TextBlock Text="Telemetry and data collection" Foreground="#B0B0B0" />
                            </StackPanel>
                            <Border BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="0,18">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Anonymous telemetry" FontSize="15" />
                                        <TextBlock Text="Sends anonymous usage data to help improve Axorith"
                                                   FontSize="12" Foreground="#888888" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding TelemetryEnabled}"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.Name="Anonymous telemetry" />
                                </Grid>
                            </Border>
                            <Border Classes="Card" Padding="16">
                                <StackPanel Spacing="7">
                                    <TextBlock Text="Data collected" FontWeight="SemiBold" />
                                    <TextBlock Text="App version and operating system&#x0a;Feature usage&#x0a;Error reports&#x0a;No personal data or IP addresses"
                                               FontSize="12" Foreground="#888888" LineHeight="20" />
                                </StackPanel>
                            </Border>
                            <Button Content="View privacy policy" Command="{Binding OpenPrivacyPolicyCommand}"
                                    Classes="secondary" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Spacing="18" IsVisible="{Binding IsAboutSection}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="About" FontSize="22" FontWeight="Bold" />
                                <TextBlock Text="Axorith application information" Foreground="#B0B0B0" />
                            </StackPanel>
                            <Border BorderBrush="#333333" BorderThickness="0,1,0,0" Padding="0,18">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Version" FontSize="15" />
                                        <TextBlock Text="Axorith desktop client" FontSize="12" Foreground="#888888" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding AppVersion}" Foreground="#B0B0B0"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Command="{Binding OpenGitHubCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource GitHubIcon}" Width="16" Height="16" />
                                        <TextBlock Text="GitHub" />
                                    </StackPanel>
                                </Button>
                                <Button Content="Run setup wizard" Command="{Binding RunSetupWizardCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
