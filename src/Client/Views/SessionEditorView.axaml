<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Axorith.Client.ViewModels"
             xmlns:core="using:Axorith.Core.Models"
             xmlns:converters="using:Axorith.Client.Converters"
             xmlns:selectors="using:Axorith.Client.Selectors"
             x:Class="Axorith.Client.Views.SessionEditorView"
             x:DataType="vm:SessionEditorViewModel">
    <UserControl.Styles>
        <Style Selector="TransitioningContentControl">
            <Setter Property="PageTransition">
                <CrossFade Duration="0:0:0.15" />
            </Setter>
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>


        <DataTemplate x:Key="InlineActionTemplate" x:DataType="vm:ActionViewModel">
            <Button Content="{Binding Label}" Command="{Binding InvokeCommand}"
                    IsVisible="{Binding IsVisible}"
                    BorderThickness="1" CornerRadius="0,6,6,0" Padding="8,0" MinWidth="64" Height="36"
                    FontSize="11" FontWeight="SemiBold" Classes="inline-action"
                    Classes.success="{Binding IsSuccess}" Classes.failure="{Binding IsFailure}"
                    ToolTip.Tip="{Binding Label}" AutomationProperties.Name="{Binding Label}">
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ApplicationChoiceItemTemplate" x:DataType="vm:ApplicationChoiceViewModel">
            <Border Background="{DynamicResource BackgroundSecondaryBrush}" BorderBrush="{DynamicResource BorderPrimaryBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="8" Margin="0,0,0,4">
                <Grid ColumnDefinitions="36,*,76" ColumnSpacing="10" MinHeight="52">
                    <Border Grid.Column="0" Width="32" Height="32" Background="{DynamicResource BackgroundSelectedBrush}"
                            CornerRadius="6" VerticalAlignment="Center">
                        <Grid>
                            <PathIcon Data="M4,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M4,6V8H20V6H4M4,18H20V10H4V18Z"
                                      Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image Source="{Binding Icon}"
                                   Width="26" Height="26" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Path}"
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Command="{Binding SelectCommand}"
                            CommandParameter="{Binding Choice}"
                            Content="{Binding SelectorItemActionLabel}"
                            Width="76" Height="30" Padding="4"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center" Classes="accent"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ApplicationPickerPopupTemplate" x:DataType="vm:SettingViewModel">
            <Border Background="{DynamicResource BackgroundSecondaryBrush}" BorderBrush="{DynamicResource BorderPrimaryBrush}" BorderThickness="1"
                    CornerRadius="7" Padding="6" BoxShadow="{DynamicResource PopupShadow}">
                <StackPanel Spacing="6">
                    <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                             IsVisible="{Binding ShowPopupSearch}" Watermark="Search apps..."
                             Classes="setting-input"/>
                    <ListBox ItemsSource="{Binding ApplicationChoices}" MaxHeight="320"
                             Background="{DynamicResource TransparentBrush}" BorderThickness="0" Padding="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.IsScrollChainingEnabled="False"
                             ItemTemplate="{StaticResource ApplicationChoiceItemTemplate}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <StreamGeometry x:Key="TimerIcon">M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z</StreamGeometry>
        <StreamGeometry x:Key="ArrowUpIcon">M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z</StreamGeometry>
        <StreamGeometry x:Key="ArrowDownIcon">M7.41,8.59L12,13.17L16.59,8.59L18,10L12,16L6,10L7.41,8.59Z</StreamGeometry>
        <StreamGeometry x:Key="SearchIcon">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
        <StreamGeometry x:Key="PlusIcon">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
        <StreamGeometry x:Key="DeleteIcon">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</StreamGeometry>
        <StreamGeometry x:Key="CloseIcon">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</StreamGeometry>
        <StreamGeometry x:Key="PlayIcon">M8,5.14V19.14L19,12.14L8,5.14Z</StreamGeometry>
        <StreamGeometry x:Key="LockPcIcon">M18,8H17V6A5,5 0 0,0 7,6V8H6A2,2 0 0,0 4,10V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V10A2,2 0 0,0 18,8M9,6A3,3 0 0,1 15,6V8H9V6M18,20H6V10H18V20M12,12A2,2 0 0,0 10,14C10,14.74 10.4,15.38 11,15.73V18H13V15.73C13.6,15.38 14,14.74 14,14A2,2 0 0,0 12,12Z</StreamGeometry>
        <StreamGeometry x:Key="SleepPcIcon">M12,2A10,10 0 1,0 22,12C22,11.53 21.97,11.07 21.9,10.62A8,8 0 0,1 11.38,2.1C11.58,2.04 11.79,2 12,2M12,20A8,8 0 0,1 8.42,4.84A10,10 0 0,0 19.16,15.58A8,8 0 0,1 12,20Z</StreamGeometry>
        <StreamGeometry x:Key="SignOutIcon">M17,7L15.59,8.41L18.17,11H8V13H18.17L15.59,15.59L17,17L22,12L17,7M4,5H12V3H4A2,2 0 0,0 2,5V19A2,2 0 0,0 4,21H12V19H4V5Z</StreamGeometry>
        <StreamGeometry x:Key="PowerIcon">M13,3H11V13H13V3M17.83,6.17L16.41,7.59A8,8 0 1,1 7.59,7.59L6.17,6.17A10,10 0 1,0 17.83,6.17Z</StreamGeometry>

        <DataTemplate x:Key="ScheduledTriggerCardTemplate" x:DataType="vm:TriggerViewModel">
            <Button Classes="ItemCard" Margin="0,0,0,10" Classes.error="{Binding HasError}"
                    Command="{Binding $parent[UserControl].DataContext.EditTriggerCommand}"
                    CommandParameter="{Binding}">
                <Border>
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Background="{DynamicResource BackgroundSelectedBrush}" CornerRadius="6"
                                Width="40" Height="40" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource TimerIcon}" Width="20" Height="20"
                                      Foreground="{Binding EditorAccentType, Converter={StaticResource NotificationTypeToBrushConverter}}"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="15,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock Text="{Binding Description}" FontSize="13" Opacity="0.6"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="delete-btn" ToolTip.Tip="Remove"
                                    Command="{Binding $parent[UserControl].DataContext.RemoveTriggerCommand}"
                                    CommandParameter="{Binding}">
                                <PathIcon Data="{StaticResource DeleteIcon}" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="TextSettingTemplate" x:DataType="vm:SettingViewModel">
            <TextBox Text="{Binding StringValue, Mode=TwoWay}"
                     IsEnabled="{Binding !IsReadOnly}"
                     Classes="setting-input"
                     Classes.error="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBox.InnerRightContent>
                    <ContentControl Content="{Binding InlineAction}"
                                    ContentTemplate="{StaticResource InlineActionTemplate}"/>
                </TextBox.InnerRightContent>
            </TextBox>
        </DataTemplate>

        <DataTemplate x:Key="TextAreaSettingTemplate" x:DataType="vm:SettingViewModel">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch" MinWidth="0">
                    <TextBox Grid.Column="0" Text="{Binding StringValue, Mode=TwoWay}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"
                             IsEnabled="{Binding !IsReadOnly}" MinWidth="0"
                             Classes="setting-input"
                             Classes.appPicker="{Binding IsCustomAppsField}"
                             Classes.error="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    </TextBox>
                    <Button Grid.Column="1" Command="{Binding ApplicationPicker.OpenApplicationSelectorCommand}"
                            IsVisible="{Binding IsCustomAppsField}" IsEnabled="{Binding !IsReadOnly}" BorderThickness="1"
                            CornerRadius="0,6,6,0" Padding="0" MinHeight="80" Width="44"
                            ToolTip.Tip="Add an installed app">
                        <PathIcon Data="{StaticResource SearchIcon}" Width="17" Height="17"/>
                    </Button>
                </Grid>
                <ContentControl Content="{Binding ApplicationPicker}"
                                ContentTemplate="{StaticResource ApplicationPickerPopupTemplate}"
                                IsVisible="{Binding ApplicationPicker.IsSelectorOpen}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SecretSettingTemplate" x:DataType="vm:SettingViewModel">
            <TextBox Text="{Binding StringValue, Mode=TwoWay}"
                     PasswordChar="•"
                     Watermark="Enter secret value..."
                     IsEnabled="{Binding !IsReadOnly}"
                     Classes="setting-input"
                     Classes.error="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            </TextBox>
        </DataTemplate>

        <DataTemplate x:Key="CheckboxSettingTemplate" x:DataType="vm:SettingViewModel">
            <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}"
                      Content="{Binding Label}"
                      IsEnabled="{Binding !IsReadOnly}"/>
        </DataTemplate>

        <DataTemplate x:Key="NumberSettingTemplate" x:DataType="vm:SettingViewModel">
            <NumericUpDown Value="{Binding DecimalValue, Mode=TwoWay}"
                           Increment="{Binding NumberIncrement}"
                           FormatString="{Binding NumberFormatString}"
                           IsEnabled="{Binding !IsReadOnly}"
                           HorizontalAlignment="Stretch"
                           CornerRadius="6"
                           Padding="10,8"
                           Classes.error="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            </NumericUpDown>
        </DataTemplate>

        <DataTemplate x:Key="ChoiceSettingTemplate" x:DataType="vm:SettingViewModel">
            <StackPanel Spacing="6">
                <Grid x:Name="ApplicationSelectorRoot" ColumnDefinitions="*,44"
                      IsVisible="{Binding IsApplicationSelector}">
                    <TextBox x:Name="ApplicationInput"
                             Grid.Column="0"
                             Text="{Binding ApplicationInputText, Mode=TwoWay}"
                             Watermark="Select application..."
                             Classes="setting-input" CornerRadius="6,0,0,6"/>
                    <Button Grid.Column="1"
                            Command="{Binding OpenApplicationSelectorCommand}" BorderThickness="1,1,1,1"
                            CornerRadius="0,6,6,0" Padding="0" Width="44" Height="38">
                        <PathIcon Data="{StaticResource SearchIcon}" Width="17" Height="17"/>
                    </Button>
                    <Popup PlacementTarget="{Binding #ApplicationSelectorRoot}"
                           Placement="Bottom"
                           IsOpen="{Binding IsSelectorOpen, Mode=TwoWay}"
                           IsLightDismissEnabled="False"
                           Width="540">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ApplicationPickerPopupTemplate}"/>
                    </Popup>
                </Grid>
                <ComboBox ItemsSource="{Binding DisplayedChoices}"
                          SelectedItem="{Binding SelectedChoice}"
                          IsVisible="{Binding !IsApplicationSelector}"
                          HorizontalAlignment="Stretch"
                          IsEnabled="{Binding !IsReadOnly}"
                          MaxDropDownHeight="300"
                          Classes.error="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Value}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Value}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PathPickerSettingTemplate" x:DataType="vm:SettingViewModel">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding StringValue, Mode=TwoWay}"
                         Watermark="{Binding PickerWatermark}"
                         Classes="setting-input"
                         IsEnabled="{Binding !IsReadOnly}"
                         Classes.error="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                </TextBox>

                <ComboBox Grid.Column="1"
                          Classes="history"
                          ItemsSource="{Binding History}"
                          SelectedItem="{Binding SelectedHistoryItem}"
                          Margin="4,0,0,0"
                          IsVisible="{Binding History.Count}"
                          ToolTip.Tip="{Binding PickerHistoryToolTip}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Background="{DynamicResource TransparentBrush}">
                                <TextBlock Grid.Column="0" Text="{Binding}" TextTrimming="CharacterEllipsis" MaxWidth="350" VerticalAlignment="Center"/>

                                <Button Grid.Column="1"
                                        Classes="icon delete-btn"
                                        Command="{Binding $parent[ComboBox].DataContext.RemoveHistoryItemCommand}"
                                        CommandParameter="{Binding}"
                                        Width="24" Height="24" Padding="4" Margin="8,0,0,0"
                                        ToolTip.Tip="Remove from history">
                                    <PathIcon Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"
                                              Width="12" Height="12"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="2" Content="..." Margin="4,0,0,0" Command="{Binding BrowseCommand}" IsEnabled="{Binding !IsReadOnly}"/>
            </Grid>
        </DataTemplate>

                <DataTemplate x:Key="TimeTriggerEditorTemplate" x:DataType="vm:TimeTriggerViewModel">
            <Panel>
                <Border Background="{DynamicResource OverlayBrush}"/>

                <Border Background="{DynamicResource BackgroundTertiaryBrush}"
                        BorderBrush="{DynamicResource BorderPrimaryBrush}"
                        BorderThickness="1"
                        Width="520"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        CornerRadius="12"
                        BoxShadow="{DynamicResource DialogShadow}">

                    <Grid RowDefinitions="Auto, *">
                        <Border Grid.Row="0"
                                Padding="20,16"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource BorderSecondaryBrush}"
                                Background="{DynamicResource BackgroundTertiaryBrush}"
                                CornerRadius="12,12,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="✕"
                                        Command="{Binding $parent[UserControl].DataContext.CloseTriggerCommand}" CommandParameter="{Binding}"
                                        Classes="link"
                                        FontSize="18"
                                        Padding="8"
                                        Margin="10,-5,-10,-5"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="{StaticResource TimerIcon}" Width="18" Height="18" Foreground="{Binding EditorAccentType, Converter={StaticResource NotificationTypeToBrushConverter}}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding EditorTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Border Padding="24">
                                <StackPanel Spacing="24">
                                    <StackPanel Spacing="20">
                                        <Grid ColumnDefinitions="120, *">
                                            <TextBlock Grid.Column="0" Text="{Binding TimeLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <NumericUpDown Value="{Binding Hours}"
                                                               Minimum="{Binding Use24HourFormat, Converter={x:Static converters:AppConverters.BoolToMinHour}}"
                                                               Maximum="{Binding Use24HourFormat, Converter={x:Static converters:AppConverters.BoolToMaxHour}}"
                                                               FormatString="0"
                                                               Width="70"
                                                               Height="32"
                                                               Padding="8,0"
                                                               ShowButtonSpinner="False"
                                                               HorizontalContentAlignment="Center"
                                                               VerticalContentAlignment="Center"
                                                               Classes.error="{Binding HasTimeError}"/>
                                                <TextBlock Text=":" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="16" FontWeight="Bold"/>
                                                <NumericUpDown Value="{Binding Minutes}"
                                                               Minimum="0" Maximum="59"
                                                               FormatString="00"
                                                               Width="70"
                                                               Height="32"
                                                               Padding="8,0"
                                                               ShowButtonSpinner="False"
                                                               HorizontalContentAlignment="Center"
                                                               VerticalContentAlignment="Center"
                                                               Classes.error="{Binding HasTimeError}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding !Use24HourFormat}" Margin="8,0,0,0">
                                                    <RadioButton Content="AM"
                                                                 IsChecked="{Binding IsAm}"
                                                                 GroupName="{Binding EditorTitle}"
                                                                 Padding="8,4"
                                                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <RadioButton Content="PM"
                                                                 IsChecked="{Binding !IsAm}"
                                                                 GroupName="{Binding EditorTitle}"
                                                                 Padding="8,4"
                                                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <Grid ColumnDefinitions="120, *">
                                            <TextBlock Grid.Column="0" Text="" VerticalAlignment="Center"/>
                                            <CheckBox Grid.Column="1"
                                                      IsChecked="{Binding Use24HourFormat}"
                                                      Content="Use 24-hour format"
                                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>

                                        <Grid ColumnDefinitions="120, *">
                                            <TextBlock Grid.Column="0" Text="Repeat On" VerticalAlignment="Top" Margin="0,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium"/>
                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource BackgroundPrimaryBrush}"
                                                    BorderBrush="{DynamicResource BorderPrimaryBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="8,12">
                                                <UniformGrid Rows="1" Columns="7">
                                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                        <TextBlock Text="Mon" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                        <CheckBox IsChecked="{Binding RunOnMonday}" HorizontalAlignment="Center" Padding="0" MinWidth="0"/>
                                                    </StackPanel>
                                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                        <TextBlock Text="Tue" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                        <CheckBox IsChecked="{Binding RunOnTuesday}" HorizontalAlignment="Center" Padding="0" MinWidth="0"/>
                                                    </StackPanel>
                                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                        <TextBlock Text="Wed" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                        <CheckBox IsChecked="{Binding RunOnWednesday}" HorizontalAlignment="Center" Padding="0" MinWidth="0"/>
                                                    </StackPanel>
                                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                        <TextBlock Text="Thu" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                        <CheckBox IsChecked="{Binding RunOnThursday}" HorizontalAlignment="Center" Padding="0" MinWidth="0"/>
                                                    </StackPanel>
                                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                        <TextBlock Text="Fri" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                        <CheckBox IsChecked="{Binding RunOnFriday}" HorizontalAlignment="Center" Padding="0" MinWidth="0"/>
                                                    </StackPanel>
                                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                        <TextBlock Text="Sat" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                        <CheckBox IsChecked="{Binding RunOnSaturday}" HorizontalAlignment="Center" Padding="0" MinWidth="0"/>
                                                    </StackPanel>
                                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                        <TextBlock Text="Sun" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                        <CheckBox IsChecked="{Binding RunOnSunday}" HorizontalAlignment="Center" Padding="0" MinWidth="0"/>
                                                    </StackPanel>
                                                </UniformGrid>
                                            </Border>
                                        </Grid>
                                    </StackPanel>

                                    <Button Content="Done"
                                            Command="{Binding $parent[UserControl].DataContext.CloseTriggerCommand}" CommandParameter="{Binding}"
                                            Classes="accent"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Padding="10"
                                            FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Panel>
        </DataTemplate>

        <DataTemplate x:Key="MultiChoiceSettingTemplate" DataType="vm:SettingViewModel">
            <Border Background="{DynamicResource BackgroundPrimaryBrush}" BorderBrush="{DynamicResource BorderPrimaryBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                <ItemsControl ItemsSource="{Binding MultiChoices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:MultiChoiceItemViewModel">
                            <CheckBox IsChecked="{Binding IsSelected}"
                                      Content="{Binding Label}"
                                      Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ButtonSettingTemplate" x:DataType="vm:SettingViewModel">
            <Button Content="{Binding Label}" Command="{Binding ClickCommand}" IsEnabled="{Binding !IsReadOnly}" HorizontalAlignment="Left"/>
        </DataTemplate>

        <selectors:SettingTemplateSelector x:Key="SettingSelector"
                                           TextTemplate="{StaticResource TextSettingTemplate}"
                                           TextAreaTemplate="{StaticResource TextAreaSettingTemplate}"
                                           SecretTemplate="{StaticResource SecretSettingTemplate}"
                                           CheckboxTemplate="{StaticResource CheckboxSettingTemplate}"
                                           NumberTemplate="{StaticResource NumberSettingTemplate}"
                                           ChoiceTemplate="{StaticResource ChoiceSettingTemplate}"
                                           PathPickerTemplate="{StaticResource PathPickerSettingTemplate}"
                                           MultiChoiceTemplate="{StaticResource MultiChoiceSettingTemplate}"
                                           ButtonTemplate="{StaticResource ButtonSettingTemplate}"/>

        <DataTemplate x:Key="ModuleSettingRowTemplate" x:DataType="vm:SettingViewModel">
            <StackPanel Margin="0,0,0,24" IsVisible="{Binding IsVisible}" HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding Label}" FontWeight="Medium" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,6" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding Setting.Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                           TextWrapping="Wrap" MaxWidth="520" Margin="0,0,0,10" HorizontalAlignment="Left"
                           IsVisible="{Binding Setting.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SettingSelector}"
                                HorizontalAlignment="Stretch"/>
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorPrimaryBrush}" FontSize="12" Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ModuleActionRowTemplate" x:DataType="vm:ActionViewModel">
            <Button Content="{Binding Label}" Command="{Binding InvokeCommand}"
                    IsVisible="{Binding IsVisibleInActionsList}" HorizontalAlignment="Stretch"
                    Margin="0,0,0,16" Padding="10"/>
        </DataTemplate>
    </UserControl.Resources>

    <Panel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden">
            <Panel MaxWidth="800" HorizontalAlignment="Center">
                <StackPanel Margin="20,30" Spacing="0">

                    <Border Classes="Card" Padding="24" Margin="0" MinWidth="500">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Preset Name" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBox Text="{Binding Name}" Watermark="e.g. Deep Work, Gaming..." FontSize="16" Padding="10" CornerRadius="6"/>
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorPrimaryBrush}" FontSize="13" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                            <Border Background="{DynamicResource ErrorBackgroundBrush}"
                                    BorderBrush="{DynamicResource ErrorPrimaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,15,0,0"
                                    IsVisible="{Binding HasValidationErrors}">
                                <Grid ColumnDefinitions="Auto, *">
                                    <PathIcon Grid.Column="0" Data="M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                                              Foreground="{DynamicResource ErrorPrimaryBrush}"
                                              Width="20" Height="20"
                                              VerticalAlignment="Top"
                                              Margin="0,2,10,0"/>

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Configuration Error"
                                                   Foreground="{DynamicResource ErrorPrimaryBrush}"
                                                   FontWeight="Bold"
                                                   FontSize="14"/>
                                        <TextBlock Text="Please fix the highlighted configuration errors before saving."
                                                   Foreground="{DynamicResource ErrorTextBrush}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="FocusCommitmentCard" Classes="Card" Classes.error="{Binding FocusCommitmentError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Padding="24" Margin="0,40,0,0" Width="500">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Focus commitment" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Choose whether this Workspace can be stopped once it starts."
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="13" TextWrapping="Wrap"/>
                            <ComboBox ItemsSource="{Binding FocusCommitmentModes}"
                                      SelectedIndex="{Binding FocusCommitmentModeIndex, Mode=TwoWay}"/>

                            <StackPanel IsVisible="{Binding IsCommittedMode}" Spacing="10">
                                <Border Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="10" IsVisible="{Binding IsStrictMode}">
                                    <TextBlock Text="Strict requires Windows protection. The Host will refuse to start if it cannot enable that protection."
                                               Foreground="{DynamicResource WarningPrimaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="Breaks" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                <ComboBox ItemsSource="{Binding BreakOptions}"
                                          SelectedIndex="{Binding BreakPresetIndex, Mode=TwoWay}"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding IsCustomBreakBudget}">
                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Number of breaks" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                        <NumericUpDown Value="{Binding BreakCount, Mode=TwoWay}" Minimum="1" Maximum="5"
                                                       Increment="1" FormatString="0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="5">
                                        <TextBlock Text="Minutes per break" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                                        <NumericUpDown Value="{Binding BreakDurationMinutes, Mode=TwoWay}" Minimum="1" Maximum="60"
                                                       Increment="1" FormatString="0"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="ScheduleLockPanel" Spacing="8" IsVisible="{Binding HasScheduledStart}">
                                    <TextBlock Text="Lock configuration before scheduled start" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                    <ComboBox ItemsSource="{Binding ScheduleLockOptions}"
                                              SelectedIndex="{Binding ScheduleLockIndex, Mode=TwoWay}"/>
                                    <TextBlock Text="{Binding ScheduledConfigurationLockStatus}"
                                               Foreground="{DynamicResource WarningPrimaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="FocusCommitmentErrorText" Text="{Binding FocusCommitmentError}"
                                       Foreground="{DynamicResource ErrorPrimaryBrush}" FontSize="12" TextWrapping="Wrap"
                                       IsVisible="{Binding FocusCommitmentError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </StackPanel>
                    </Border>

                    <Path Data="M 0 0 L 0 40" Stroke="{DynamicResource BorderHoverBrush}" StrokeThickness="1" HorizontalAlignment="Center" Margin="0"/>

                    <Border Classes="Card" Padding="24" Margin="0" MinWidth="500">
                        <StackPanel Spacing="15">
                            <TextBlock Text="Start On..." FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <ItemsControl ItemsSource="{Binding Triggers}" ItemTemplate="{StaticResource ScheduledTriggerCardTemplate}"/>

                            <Button HorizontalAlignment="Stretch"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Cursor="Hand"
                                    IsEnabled="{Binding CanAddAnyTrigger}">
                                <Button.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuItem Header="Time Schedule" Command="{Binding AddScheduleTriggerCommand}">
                                            <MenuItem.Icon>
                                                <PathIcon Data="{StaticResource TimerIcon}" Width="14" Height="14"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                    <PathIcon Data="{StaticResource PlusIcon}" Width="12" Height="12"/>
                                    <TextBlock Text="Add Trigger" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="If empty, start manually via button."
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12"
                                       Margin="0,5,0,0"
                                       IsVisible="{Binding !Triggers.Count}"/>
                        </StackPanel>
                    </Border>

                    <Path Data="M 0 0 L 0 40" Stroke="{DynamicResource BorderHoverBrush}" StrokeThickness="1" HorizontalAlignment="Center" Margin="0"/>

                    <ListBox Classes="workflow-list" ItemsSource="{Binding ConfiguredModules}"
                             Background="{DynamicResource TransparentBrush}"
                             BorderThickness="0"
                             Padding="0"
                             HorizontalAlignment="Center"
                             SelectionMode="Single"
                             SelectedItem="{Binding SelectedModule}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConfiguredModuleViewModel">
                                <StackPanel Spacing="0" HorizontalAlignment="Center">
                                    <Button Classes="ItemCard"
                                            Command="{Binding $parent[ListBox].DataContext.OpenModuleSettingsCommand}"
                                            CommandParameter="{Binding}"
                                            Width="500">
                                        <Border Classes.error="{Binding HasErrors}"
                                                Classes.warning="{Binding HasWarnings}"
                                                ToolTip.Tip="{Binding WarningMessage}">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="16"/>
                                                    <TextBlock Text="{Binding Definition.Description}" FontSize="13" TextWrapping="Wrap" MaxWidth="400" Margin="0,6,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="15,0,0,0">
                                                    <Button Classes="move-btn" Command="{Binding $parent[ListBox].DataContext.MoveUpCommand}" CommandParameter="{Binding}" IsEnabled="{Binding !IsFirst}" ToolTip.Tip="Move Up">
                                                        <PathIcon Data="{StaticResource ArrowUpIcon}" Width="16" Height="16"/>
                                                    </Button>
                                                    <Button Classes="move-btn" Command="{Binding $parent[ListBox].DataContext.MoveDownCommand}" CommandParameter="{Binding}" IsEnabled="{Binding !IsLast}" ToolTip.Tip="Move Down">
                                                        <PathIcon Data="{StaticResource ArrowDownIcon}" Width="16" Height="16"/>
                                                    </Button>
                                                    <Button Classes="delete-btn" Command="{Binding $parent[ListBox].DataContext.RemoveModuleCommand}" CommandParameter="{Binding}" ToolTip.Tip="Remove">
                                                        <PathIcon Data="{StaticResource DeleteIcon}" Width="16" Height="16"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Button>

                                    <Grid Height="60" IsVisible="{Binding !IsLast}" HorizontalAlignment="Center">
                                        <Rectangle Width="1" Fill="{DynamicResource BorderPrimaryBrush}" VerticalAlignment="Stretch" HorizontalAlignment="Center"/>

                                        <Border Background="{DynamicResource BackgroundTertiaryBrush}" BorderBrush="{DynamicResource BorderPrimaryBrush}" BorderThickness="1" CornerRadius="12" Padding="8,2"
                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                IsVisible="{Binding NextModule.HasDelay}">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <PathIcon Data="{StaticResource TimerIcon}" Width="12" Height="12" Foreground="{DynamicResource AccentInfoBrush}"/>
                                                <TextBlock Text="Wait" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>

                                                <TextBox Classes="delay-input" Text="{Binding NextModule.StartDelaySecondsString, Mode=TwoWay}"
                                                         Width="36" Height="22" Padding="0" FontSize="13"
                                                         TextAlignment="Center"
                                                         VerticalContentAlignment="Center"
                                                         Background="{DynamicResource TransparentBrush}" BorderThickness="0"
                                                         MaxLength="3">
                                                </TextBox>
                                                <TextBlock Text="s" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>

                                                <Button Classes="RemoveDelay"
                                                        Command="{Binding RemoveDelayCommand}"
                                                        ToolTip.Tip="Remove Delay"
                                                        Margin="4,0,0,0">
                                                    <PathIcon Data="{StaticResource CloseIcon}" Width="8" Height="8"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <Button Classes="ConnectorNode"
                                                IsVisible="{Binding !NextModule.HasDelay}"
                                                ToolTip.Tip="Add Action">
                                            <Button.Flyout>
                                                <MenuFlyout Placement="Bottom">
                                                    <MenuItem Header="Add Delay" Command="{Binding AddDelayCommand}">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource TimerIcon}" Width="14" Height="14"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                            <PathIcon Data="{StaticResource PlusIcon}" Width="10" Height="10"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel MinWidth="500" Margin="0,0,0,0" Spacing="0">
                        <Path Data="M 0 0 L 0 30" Stroke="{DynamicResource BorderHoverBrush}" StrokeThickness="1" HorizontalAlignment="Center" Margin="0" IsVisible="{Binding ConfiguredModules.Count}"/>

                        <Button Command="{Binding OpenAddModuleCommand}"
                                Classes="CardButton"
                                HorizontalAlignment="Center"
                                Cursor="Hand">
                            <Border Classes="Card" Padding="20,15" CornerRadius="8">
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <PathIcon Data="{StaticResource PlusIcon}" Width="14" Height="14" Foreground="{DynamicResource AccentInfoBrush}"/>
                                    <TextBlock Text="Add Module" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Button>
                    </StackPanel>

                    <Path Data="M 0 0 L 0 40" Stroke="{DynamicResource BorderHoverBrush}" StrokeThickness="1" HorizontalAlignment="Center" Margin="0"/>

                    <Border x:Name="StopOnCard" Classes="Card" Padding="24" MinWidth="500">
                        <StackPanel Spacing="15">
                            <TextBlock x:Name="StopOnHeading" Text="Stop On..." FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <ItemsControl ItemsSource="{Binding StopTriggers}" ItemTemplate="{StaticResource ScheduledTriggerCardTemplate}"/>

                            <Button x:Name="AddStopTriggerButton" HorizontalAlignment="Stretch"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Cursor="Hand">
                                <Button.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuItem Header="Fixed Time"
                                                  Command="{Binding AddStopAtTimeTriggerCommand}"
                                                  IsEnabled="{Binding CanAddStopAtTimeTrigger}">
                                            <MenuItem.Icon>
                                                <PathIcon Data="{StaticResource TimerIcon}" Width="14" Height="14"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Session Duration"
                                                  Command="{Binding AddStopAfterDurationTriggerCommand}"
                                                  IsEnabled="{Binding CanAddStopAfterDurationTrigger}">
                                            <MenuItem.Icon>
                                                <PathIcon Data="{StaticResource TimerIcon}" Width="14" Height="14"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                    <PathIcon Data="{StaticResource PlusIcon}" Width="12" Height="12"/>
                                    <TextBlock Text="Add Stop Trigger" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="If empty, stop manually via button."
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12"
                                       Margin="0,5,0,0"
                                       IsVisible="{Binding !StopTriggers.Count}"/>
                        </StackPanel>
                    </Border>

                    <Path Data="M 0 0 L 0 40" Stroke="{DynamicResource BorderHoverBrush}" StrokeThickness="1" HorizontalAlignment="Center" Margin="0"/>

                    <Border x:Name="ThenCard" Classes="Card" Padding="24" MinWidth="500" Margin="0,0,0,120">
                        <StackPanel Spacing="15">
                            <TextBlock x:Name="ThenHeading" Text="Then..." FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <ItemsControl ItemsSource="{Binding ThenTriggers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ThenActionTriggerViewModel">
                                        <Border Classes="ItemCard" Margin="0,0,0,10"
                                                Classes.error="{Binding HasError}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                                <Border Background="{DynamicResource BackgroundSelectedBrush}" CornerRadius="6" Width="40" Height="40"
                                                        VerticalAlignment="Center">
                                                    <PathIcon Data="{StaticResource PlayIcon}" Width="20" Height="20"
                                                              Foreground="{DynamicResource SuccessPrimaryBrush}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="15,0" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="13" Opacity="0.7"
                                                               IsVisible="{Binding !IsNoOtherPresetsAvailable}"/>
                                                    <TextBlock Text="No other Workspaces are available."
                                                               FontSize="13" Opacity="0.7"
                                                               IsVisible="{Binding IsNoOtherPresetsAvailable}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="delete-btn"
                                                        Command="{Binding $parent[ItemsControl].DataContext.RemoveThenTriggerCommand}"
                                                        CommandParameter="{Binding}" ToolTip.Tip="Remove">
                                                    <PathIcon Data="{StaticResource DeleteIcon}" Width="16" Height="16"/>
                                                </Button>
                                                <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                          Margin="15,10,0,0"
                                                          ItemsSource="{Binding $parent[UserControl].DataContext.AvailablePresetsForNext}"
                                                          SelectedItem="{Binding SelectedNextPreset}"
                                                          IsVisible="{Binding IsNextPresetSelectionVisible}"
                                                          HorizontalAlignment="Stretch"
                                                          PlaceholderText="Select Workspace"
                                                          Height="36">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button x:Name="AddThenTriggerButton" HorizontalAlignment="Stretch"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Cursor="Hand">
                                <Button.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuItem Header="Start next Workspace"
                                                  Command="{Binding AddThenActionTriggerCommand}"
                                                  CommandParameter="{x:Static core:AfterEndBehavior.StartNextWorkspace}"
                                                  IsEnabled="{Binding CanAddThenActionTrigger}">
                                            <MenuItem.Icon>
                                                <PathIcon Data="{StaticResource PlayIcon}" Width="14" Height="14"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Lock PC" Command="{Binding AddThenActionTriggerCommand}"
                                                  CommandParameter="{x:Static core:AfterEndBehavior.LockPc}"
                                                  IsEnabled="{Binding CanAddThenActionTrigger}">
                                            <MenuItem.Icon>
                                                <PathIcon Data="{StaticResource LockPcIcon}" Width="14" Height="14"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Sleep" Command="{Binding AddThenActionTriggerCommand}"
                                                  CommandParameter="{x:Static core:AfterEndBehavior.Sleep}"
                                                  IsEnabled="{Binding CanAddThenActionTrigger}">
                                            <MenuItem.Icon>
                                                <PathIcon Data="{StaticResource SleepPcIcon}" Width="14" Height="14"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Sign out" Command="{Binding AddThenActionTriggerCommand}"
                                                  CommandParameter="{x:Static core:AfterEndBehavior.SignOut}"
                                                  IsEnabled="{Binding CanAddThenActionTrigger}">
                                            <MenuItem.Icon>
                                                <PathIcon Data="{StaticResource SignOutIcon}" Width="14" Height="14"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Shut down PC" Command="{Binding AddThenActionTriggerCommand}"
                                                  CommandParameter="{x:Static core:AfterEndBehavior.ShutDownPc}"
                                                  IsEnabled="{Binding CanAddThenActionTrigger}">
                                            <MenuItem.Icon>
                                                <PathIcon Data="{StaticResource PowerIcon}" Width="14" Height="14"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                    <PathIcon Data="{StaticResource PlusIcon}" Width="12" Height="12"/>
                                    <TextBlock Text="Add Then Trigger" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="Triggers next session after stop. Does not apply when stopped manually."
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Panel>
        </ScrollViewer>

        <TransitioningContentControl Content="{Binding ModuleSelector}" IsVisible="{Binding !!ModuleSelector}">
            <TransitioningContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:ModuleSelectorViewModel">
                    <Panel>
                        <Border Background="{DynamicResource OverlayBrush}"/>
                        <Border Background="{DynamicResource BackgroundTertiaryBrush}" BorderBrush="{DynamicResource BorderPrimaryBrush}" BorderThickness="1" Width="800" MaxHeight="700" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="12" BoxShadow="{DynamicResource DialogShadow}">
                            <Grid RowDefinitions="Auto, Auto, *">
                                <Border Grid.Row="0" Padding="24" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderPrimaryBrush}" Background="{DynamicResource BackgroundTertiaryBrush}" CornerRadius="12,12,0,0">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseCommand}" Classes="link" FontSize="20" Padding="8" Margin="10,0,-10,0">
                                        </Button>
                                        <TextBlock Text="Add Module" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>

                                <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="24,20,24,10">
                                    <TextBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay}" Watermark="Search modules..." CornerRadius="6" Padding="10,8" Margin="0,0,15,0">
                                        <TextBox.InnerRightContent>
                                            <PathIcon Data="{StaticResource SearchIcon}" Width="14" Height="14" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,10,0"/>
                                        </TextBox.InnerRightContent>
                                    </TextBox>

                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Categories}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:CategoryViewModel">
                                                <RadioButton Content="{Binding Name}"
                                                             GroupName="CategoryGroup"
                                                             Command="{Binding $parent[ItemsControl].DataContext.SelectCategoryCommand}"
                                                             CommandParameter="{Binding}"
                                                             IsChecked="{Binding IsSelected}"
                                                             Theme="{StaticResource {x:Type ToggleButton}}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>

                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding FilteredModules}" Margin="24,10,24,24">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ModuleDefinitionViewModel">
                                                <Border Classes="SelectorCard" Width="360" Margin="0,0,15,15" BorderThickness="1" CornerRadius="8" Padding="16">
                                                    <Grid RowDefinitions="Auto, *, Auto">
                                                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                                            <Border Background="{DynamicResource BackgroundSelectedBrush}" CornerRadius="4" Padding="6,2" DockPanel.Dock="Right" VerticalAlignment="Top">
                                                                <TextBlock Text="{Binding Definition.Category}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Definition.Name}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>

                                                        <TextBlock Grid.Row="1" Text="{Binding Definition.Description}" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" TextWrapping="Wrap" Height="40" TextTrimming="CharacterEllipsis" Margin="0,0,0,15"/>

                                                        <Panel Grid.Row="2">
                                                            <Button Content="Add" Classes="accent" HorizontalAlignment="Stretch"
                                                                    Command="{Binding $parent[ItemsControl].DataContext.SelectModuleCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    IsVisible="{Binding !IsJustAdded}"/>

                                                            <Border IsVisible="{Binding IsJustAdded}"
                                                                    Background="{DynamicResource TransparentBrush}"
                                                                    BorderBrush="{DynamicResource SuccessPrimaryBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="6"
                                                                    Height="32">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                                                    <PathIcon Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z" Width="12" Height="12" Foreground="{DynamicResource SuccessPrimaryBrush}"/>
                                                                    <TextBlock Text="Added" Foreground="{DynamicResource SuccessPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </Panel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Panel>
                </DataTemplate>
            </TransitioningContentControl.ContentTemplate>
        </TransitioningContentControl>

        <TransitioningContentControl Content="{Binding SelectedTrigger}" ContentTemplate="{StaticResource TimeTriggerEditorTemplate}" IsVisible="{Binding !!SelectedTrigger}" />

        <TransitioningContentControl Content="{Binding SelectedStopTrigger}" ContentTemplate="{StaticResource TimeTriggerEditorTemplate}" IsVisible="{Binding SelectedStopTrigger, Converter={x:Static converters:AppConverters.IsStopAtTimeTrigger}}" />

        <TransitioningContentControl Content="{Binding SelectedStopTrigger}" IsVisible="{Binding SelectedStopTrigger, Converter={x:Static converters:AppConverters.IsStopAfterDurationTrigger}}">
            <TransitioningContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:StopAfterDurationTriggerViewModel">
            <Panel>
                <Border Background="{DynamicResource OverlayBrush}"/>
                <Border Background="{DynamicResource BackgroundTertiaryBrush}" BorderBrush="{DynamicResource BorderPrimaryBrush}" BorderThickness="1" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="12" BoxShadow="{DynamicResource DialogShadow}">
                    <Grid RowDefinitions="Auto, *">
                        <Border Grid.Row="0" Padding="20,16" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSecondaryBrush}" Background="{DynamicResource BackgroundTertiaryBrush}" CornerRadius="12,12,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="✕" Command="{Binding $parent[UserControl].DataContext.CloseTriggerCommand}" CommandParameter="{Binding}" Classes="link" FontSize="18" Padding="8" Margin="10,-5,-10,-5"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="{StaticResource TimerIcon}" Width="18" Height="18" Foreground="{DynamicResource ErrorPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Edit Session Duration" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <Border Padding="24">
                                <StackPanel Spacing="24">
                                    <StackPanel Spacing="20">
                                        <Grid ColumnDefinitions="120, *">
                                            <TextBlock Grid.Column="0" Text="Duration" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="Medium"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <NumericUpDown Value="{Binding DurationHours}" Minimum="0" Maximum="23" FormatString="0" Width="70" Height="32" Padding="8,0" ShowButtonSpinner="False" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Classes.error="{Binding HasDurationError}"/>
                                                <TextBlock Text="hours" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <NumericUpDown Value="{Binding DurationMinutes}" Minimum="0" Maximum="59" FormatString="00" Width="70" Height="32" Padding="8,0" ShowButtonSpinner="False" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Classes.error="{Binding HasDurationError}"/>
                                                <TextBlock Text="min" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Session will automatically stop after this duration from start." Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="120,0,0,0"/>
                                    </StackPanel>
                                    <Button Content="Done" Command="{Binding $parent[UserControl].DataContext.CloseTriggerCommand}" CommandParameter="{Binding}" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Panel>
        </DataTemplate>
            </TransitioningContentControl.ContentTemplate>
        </TransitioningContentControl>

        <TransitioningContentControl Content="{Binding SelectedModule}" IsVisible="{Binding !!SelectedModule}">
            <TransitioningContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:ConfiguredModuleViewModel">
                    <Panel>
                        <Border IsVisible="{Binding IsChromeExtensionDialogOpen}" ZIndex="1000"
                                Background="{DynamicResource OverlayBrush}">
                            <ScrollViewer Margin="24" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                <Border Classes="Card" MaxWidth="580" Padding="24"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                        Background="{DynamicResource BackgroundSecondaryBrush}" BorderBrush="{DynamicResource BorderHoverBrush}">
                                    <StackPanel Spacing="14" KeyboardNavigation.TabNavigation="Cycle">
                                        <TextBlock Text="Install Chrome Extension" FontSize="22" FontWeight="Bold" />
                                        <StackPanel Spacing="8" IsVisible="{Binding IsChromeExtensionDownloading}">
                                            <TextBlock Text="Downloading the latest extension from GitHub…" TextWrapping="Wrap" />
                                            <ProgressBar IsIndeterminate="True" />
                                        </StackPanel>
                                        <StackPanel Spacing="12" IsVisible="{Binding ChromeExtensionArchivePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="ZIP downloaded. Install it in Chrome:" TextWrapping="Wrap" />
                                            <SelectableTextBlock Text="{Binding ChromeExtensionArchivePath}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="1. Open the download folder and extract the ZIP into a permanent folder.&#x0a;&#x0a;2. Enter chrome://extensions in Chrome's address bar.&#x0a;&#x0a;3. Turn on Developer mode (top right).&#x0a;&#x0a;4. Click Load unpacked and select the extracted folder containing manifest.json.&#x0a;&#x0a;5. Keep that folder in place and keep Axorith running to use Site Blocker."
                                                       TextWrapping="Wrap" LineHeight="22" />
                                        </StackPanel>
                                        <StackPanel Spacing="12" IsVisible="{Binding ChromeExtensionDownloadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <TextBlock Text="{Binding ChromeExtensionDownloadError}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorPrimaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button Content="Open download folder" Classes="secondary"
                                                    Command="{Binding OpenChromeExtensionFolderCommand}"
                                                    IsVisible="{Binding ChromeExtensionArchivePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <Button Content="Retry download" Classes="accent"
                                                    Command="{Binding RetryChromeExtensionDownloadCommand}"
                                                    IsVisible="{Binding ChromeExtensionDownloadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <Button Content="Close" Classes="secondary"
                                                    Command="{Binding CloseChromeExtensionDialogCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </Border>
                        <Border Background="{DynamicResource OverlayBrush}"/>
                        <Border Background="{DynamicResource BackgroundTertiaryBrush}" BorderBrush="{DynamicResource BorderPrimaryBrush}" BorderThickness="1" Width="600" MaxHeight="800" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="12" BoxShadow="{DynamicResource DialogShadow}">
                            <Grid RowDefinitions="Auto, *">
                                <Border Grid.Row="0" Padding="30,24" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderPrimaryBrush}" Background="{DynamicResource BackgroundTertiaryBrush}" CornerRadius="12,12,0,0">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding $parent[UserControl].DataContext.CloseModuleSettingsCommand}" Classes="link" FontSize="20" Padding="8" Margin="10,0,-10,0">
                                        </Button>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding Definition.Name}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" LetterSpacing="-0.5"/>
                                            <TextBlock Text="Configuration" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" FontWeight="Medium"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                              IsScrollChainingEnabled="False">
                                    <StackPanel Spacing="0">
                                        <StackPanel Spacing="8" Margin="30,24,30,24">
                                            <TextBlock Text="Instance Name" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="Medium"/>
                                            <TextBox Text="{Binding CustomName, Mode=TwoWay}" Watermark="{Binding Definition.Name}" Classes="setting-input"/>
                                        </StackPanel>
                                        <Separator Background="{DynamicResource BorderPrimaryBrush}" Height="1" Margin="0"/>
                                        <StackPanel Margin="30,24,30,24">
                                            <ItemsControl ItemsSource="{Binding LauncherBaseSettings}"
                                                          ItemTemplate="{StaticResource ModuleSettingRowTemplate}"
                                                          IsVisible="{Binding IsApplicationLauncher}"/>
                                            <ItemsControl ItemsSource="{Binding Actions}"
                                                          ItemTemplate="{StaticResource ModuleActionRowTemplate}"
                                                          IsVisible="{Binding IsApplicationLauncher}"/>
                                            <ItemsControl ItemsSource="{Binding LauncherSubmoduleSettings}"
                                                          ItemTemplate="{StaticResource ModuleSettingRowTemplate}"
                                                          IsVisible="{Binding IsApplicationLauncher}"/>
                                            <ItemsControl ItemsSource="{Binding Actions}"
                                                          ItemTemplate="{StaticResource ModuleActionRowTemplate}"
                                                          IsVisible="{Binding IsSiteBlocker}"/>
                                            <ItemsControl x:Name="ModuleSettingsList" ItemsSource="{Binding Settings}"
                                                          ItemTemplate="{StaticResource ModuleSettingRowTemplate}"
                                                          IsVisible="{Binding !IsApplicationLauncher}"/>
                                            <ItemsControl ItemsSource="{Binding Actions}"
                                                          ItemTemplate="{StaticResource ModuleActionRowTemplate}"
                                                          IsVisible="{Binding ShowsActionsAtBottom}"/>
                                        </StackPanel>
                                        <Border Height="20"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Panel>
                </DataTemplate>
            </TransitioningContentControl.ContentTemplate>
        </TransitioningContentControl>

        <Border VerticalAlignment="Bottom" Background="{DynamicResource BackgroundTertiaryBrush}" BorderBrush="{DynamicResource BorderPrimaryBrush}" BorderThickness="0,1,0,0" Padding="20"
                IsVisible="{Binding IsFooterVisible}">
            <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Right">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Classes="secondary"/>
                <Button Content="Save Preset" Command="{Binding SaveAndCloseCommand}" Classes="accent" Padding="30,8" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
