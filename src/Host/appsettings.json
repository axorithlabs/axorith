{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Grpc": "Information"
    }
  },
  "AllowedHosts": "*",
  "Grpc": {
    "Port": 5901,
    "BindAddress": "127.0.0.1",
    "MaxConcurrentStreams": 100,
    "KeepAliveInterval": 30,
    "KeepAliveTimeout": 10,
    "KeepAlivePermitWithoutCalls": true
  },
  "Modules": {
    "SearchPaths": [
      "../Modules"
    ],
    "EnableHotReload": false
  },
  "Persistence": {
    "PresetsPath": "%AppData%/Axorith/presets",
    "LogsPath": "%AppData%/Axorith/logs"
  },
  "Session": {
    "ValidationTimeoutSeconds": 5,
    "StartupTimeoutSeconds": 30,
    "ShutdownTimeoutSeconds": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Grpc": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {ShortSourceContext}: {ModuleContext}{Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
