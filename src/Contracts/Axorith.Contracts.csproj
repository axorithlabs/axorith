<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>Axorith.Contracts</AssemblyName>
        <RootNamespace>Axorith.Contracts</RootNamespace>
        <Description>gRPC contracts for Axorith client-server communication</Description>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Grpc.Tools"  PrivateAssets="All" />
        <PackageReference Include="Grpc.Core.Api"  />
        <PackageReference Include="Google.Protobuf"  />
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="Protos\**\*.proto" GrpcServices="Both" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Core\Axorith.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="Axorith.Client" />
        <InternalsVisibleTo Include="Axorith.Host" />
    </ItemGroup>

</Project>
